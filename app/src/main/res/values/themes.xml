<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MockExamCalculator" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
    </style>

    <style name="CalculatorButton">
        <item name="android:layout_width">80dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">32sp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/circle_button</item>
    </style>

    <style name="NumButton" parent="CalculatorButton">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">#333333</item>
    </style>

    <style name="TopButton" parent="CalculatorButton">
        <item name="android:textColor">#000000</item> <item name="android:backgroundTint">#A5A5A5</item>
    </style>

    <style name="OperatorButton" parent="CalculatorButton">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">#FF9F0A</item>
    </style>

</resources>