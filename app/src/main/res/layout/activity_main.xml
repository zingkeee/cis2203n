<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="16dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:layout_marginBottom="8dp"
        android:background="#111111"><TextView
        android:id="@+id/tvHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom|end"
        android:textColor="#A5A5A5"
        android:textSize="24sp"
        android:padding="8dp"
        />
    </ScrollView>

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom|end"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="70sp"
        android:maxLines="1"
        android:layout_marginBottom="16dp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:layout_marginBottom="30dp">

        <Button android:id="@+id/btnBackspace" android:text="⌫" style="@style/TopButton"
            android:onClick="onBackspaceClick" />
        <Button android:id="@+id/btnAC" android:text="AC" style="@style/TopButton"
            android:onClick="onClearClick" />
        <Button android:id="@+id/btnID" android:text="ID" style="@style/TopButton"
            android:onClick="onCustomOperatorClick" />
        <Button android:id="@+id/btnDivide" android:text="÷" style="@style/OperatorButton"
            android:onClick="onOperatorClick" />

        <Button android:id="@+id/btn7" android:text="7" style="@style/NumButton"
            android:onClick="onNumberClick" />
        <Button android:id="@+id/btn8" android:text="8" style="@style/NumButton"
            android:onClick="onNumberClick" />
        <Button android:id="@+id/btn9" android:text="9" style="@style/NumButton"
            android:onClick="onNumberClick" />
        <Button android:id="@+id/btnMultiply" android:text="×" style="@style/OperatorButton"
            android:onClick="onOperatorClick" />

        <Button android:id="@+id/btn4" android:text="4" style="@style/NumButton"
            android:onClick="onNumberClick" />
        <Button android:id="@+id/btn5" android:text="5" style="@style/NumButton"
            android:onClick="onNumberClick" />
        <Button android:id="@+id/btn6" android:text="6" style="@style/NumButton"
            android:onClick="onNumberClick" />
        <Button android:id="@+id/btnSubtract" android:text="−" style="@style/OperatorButton"
            android:onClick="onOperatorClick" />

        <Button android:id="@+id/btn1" android:text="1" style="@style/NumButton"
            android:onClick="onNumberClick" />
        <Button android:id="@+id/btn2" android:text="2" style="@style/NumButton"
            android:onClick="onNumberClick" />
        <Button android:id="@+id/btn3" android:text="3" style="@style/NumButton"
            android:onClick="onNumberClick" />
        <Button android:id="@+id/btnAdd" android:text="+" style="@style/OperatorButton"
            android:onClick="onOperatorClick" />

        <Button android:id="@+id/btnNegate" android:text="+/-" style="@style/TopButton"
            android:onClick="onNegateClick" />
        <Button android:id="@+id/btn0" android:text="0" style="@style/NumButton"
            android:onClick="onNumberClick" />
        <Button android:id="@+id/btnDot" android:text="." style="@style/NumButton"
            android:onClick="onNumberClick" />
        <Button android:id="@+id/btnEquals" android:text="=" style="@style/OperatorButton"
            android:onClick="onEqualsClick" />
    </GridLayout>
</LinearLayout>